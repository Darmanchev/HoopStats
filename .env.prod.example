# PostgreSQL owner: used only by the database and Alembic migrations.
POSTGRES_USER=hoopstats_owner
POSTGRES_PASSWORD=replace-with-a-long-random-owner-password
POSTGRES_DB=hoopstats
DATABASE_URL=postgresql+asyncpg://hoopstats_owner:replace-with-url-escaped-owner-password@db:5432/hoopstats

# Restricted login used by backend and scheduler. Keep it different from owner.
APP_DB_USER=hoopstats_runtime
APP_DB_PASSWORD=replace-with-a-different-long-random-runtime-password

SECRET_KEY=replace-with-a-long-random-application-secret
NBA_API_KEY=
BACKEND_WORKERS=2
