# PostgreSQL used by the local Docker Compose stack.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hoopstats

# Use the Compose service name "hoopstats-db", not localhost.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@hoopstats-db:5432/hoopstats

# Development-only value. Use a strong secret in production.
SECRET_KEY=local-development-secret
NBA_API_KEY=

ALLOWED_HOSTS=localhost,127.0.0.1,testserver
API_DOCS_ENABLED=true
TEAMS_CACHE_TTL_SECONDS=300
LIVE_CACHE_TTL_SECONDS=300
LIVE_SYNC_MINUTES=15

# Browser dashboard refresh interval (five minutes).
VITE_DASHBOARD_REFRESH_MS=300000
